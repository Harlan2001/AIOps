# docker compose 环境模板：复制为 .env 后填写（.env 不入库，本模板入库）
# 多环境：dev/test/prod 各自维护一份 .env（或 CI 注入同名变量）即可，镜像不变。

# ===== GaussDB 只读连接（必填）=====
AIOPS_DB_HOST=127.0.0.1
AIOPS_DB_PORT=5432
AIOPS_DB_DATABASE=dimple
AIOPS_DB_USER=
AIOPS_DB_PASSWORD=

# ===== LLM 长尾兜底（可选；留空则纯规则路径）=====
AIOPS_LLM_ENABLED=false
AIOPS_LLM_BASE_URL=
AIOPS_LLM_API_KEY=
AIOPS_LLM_MODEL=

# ===== iQuant 事中风控实时监控（可选；ENABLED=false 时不启动）=====
AIOPS_IQUANT_ENABLED=false
AIOPS_IQUANT_BASE_URL=http://10.242.184.55:1080
AIOPS_IQUANT_USERNAME=admin
AIOPS_IQUANT_PASSWORD=
AIOPS_IQUANT_CLIENT_ID=testjwtclientid
AIOPS_IQUANT_CLIENT_SECRET=XY7kmzoNzl100
AIOPS_IQUANT_TIMEOUT=10
AIOPS_IQUANT_INTERVAL_MINUTES=5
AIOPS_IQUANT_PAGE_SIZE=100
AIOPS_IQUANT_MAX_PAGES=200
AIOPS_IQUANT_HANDLE_CLOSED=false
