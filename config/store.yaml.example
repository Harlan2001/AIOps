# 诊断结果持久化配置模板（方向一·阶段 0）
# 用法：复制本文件为 store.yaml，按需修改；store.yaml 不入库，由部署方注入。
#   copy config\store.yaml.example config\store.yaml
#
# enabled：持久化总开关。
#   false（默认）：诊断结果不写库，纯只读，不影响现有数据库与历史日志；
#   true：诊断结果经独立写连接写入下方 table（需先由部署方执行建表脚本
#         scripts/init_diag_log.sql，并建议使用仅对日志表有写权限的独立账号）。
# 也可用环境变量 AIOPS_STORE_ENABLED / AIOPS_STORE_TABLE 覆盖。
enabled: false
# 诊断日志表名（与 scripts/init_diag_log.sql 保持一致）。
table: "aiops_diag_log"
